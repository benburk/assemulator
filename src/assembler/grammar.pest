WHITESPACE = _{ " " }

comment = _{ ";" ~ (!NEWLINE ~ ANY)*}

// c-style identifier
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
// digits can be separated with underscores, e.g. 0b0000_1010
number = @{
    "0b" ~ ASCII_BIN_DIGIT ~ (ASCII_BIN_DIGIT | "_")*
    | "0x" ~ ASCII_HEX_DIGIT ~ (ASCII_HEX_DIGIT | "_")*
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")*
}

symbol = @{"."? ~ identifier}

label = @{ symbol ~ ("::" ~ symbol)* }

atom = _{ number | label | character | "(" ~ expression2 ~ ")" | "$" ~ identifier }
unary = _{ ("+" | "-" | "!" | "~")? ~ atom }
expression2 = _{ unary ~ (
    (
        "+" | "-" | "*" | "/" | "<<" | "<=" | "<" | ">>" | ">=" | ">" | "==" | "!=" |
        "&&" | "||" | "%" | "&" | "|" | "^"
    ) ~ unary)* }

expression = {expression2}

char = @{ !("\\" | "\"") ~ ASCII | "\\" ~ ("n"|"t"|"\\"|"0"|"\"") }
string = @{ char* }
string_quoted = _{ "\"" ~ string ~ "\"" }
character = ${ "'" ~ char ~ "'" }


// memory operand: an expression that may add one register, e.g. [arr + x]
memory = { "[" ~ expression ~ "]" }

arg = _{ memory | expression | string_quoted }
arg_list = _{ arg ~ ("," ~ arg)* }

directive = { "." ~ identifier ~ arg_list? }
instruction = { label ~ arg_list? }

label_declaration = ${ symbol ~ ":" ~ !":" }

line = _{ label_declaration? ~ (directive | instruction)? ~ comment? ~ NEWLINE }

lines = _{ SOI ~ line* ~ EOI }
